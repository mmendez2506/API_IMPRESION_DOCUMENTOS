# Plantilla de variables de entorno de API_IMPRESION_DOCUMENTOS.
# Copiar como .env y completar. Nunca subir el .env con valores reales.

# -- SERVER CONFIG --
SERVER_IP=
SERVER_PORT=3100

# Ambiente: DEVELOPMENT o PRODUCTION (APP_ENV tiene prioridad sobre NODE_ENV)
NODE_ENV=development
#APP_ENV=

# Seguridad: el mismo secreto de API_SISCAEX_WEB, para aceptar los tokens que emite su login
ACCESS_TOKEN_SECRET=

# Solo para pruebas locales: no pide token. Se ignora en PRODUCTION.
#PRINT_AUTH_DISABLED=true

# Orígenes permitidos por CORS (separados por coma). Sin valor, la API acepta cualquier origen.
CORS_ORIGINS=

# Swagger
SWAGGER_URL=http://localhost:3100

# -- ORIGEN DE DATOS --
# sp     -> procedimiento almacenado (por defecto)
# sample -> datos de ejemplo de data/manifiestos-ejemplo.json, sin base de datos
PRINT_DATA_SOURCE=sp
# Nombre del SP; por defecto la versión QA_
#SP_IMPRESION_MANIFIESTO=QA_sp_ImpresionManifiesto

# -- IMPRESIÓN --
# Texto de "Modulo:" en el pie cuando el cliente no lo envía
#PRINT_MODULE_NAME=SISCAEX WEB
#PRINT_TIMEZONE=America/Guatemala
# Páginas de Chromium abiertas al mismo tiempo
#PRINT_MAX_PAGES=4
# Chrome o Chromium ya instalado en el servidor (si no, se usa el que descarga npm)
#PUPPETEER_EXECUTABLE_PATH=

# -- SISCAEX --
DB_PORT=

# -- PRODUCTION --
SISCAEX_DB_HOST_PRODUCTION=
SISCAEX_DB_USER_PRODUCTION=
SISCAEX_DB_PASSWORD_PRODUCTION=

# -- DEVELOPMENT --
SISCAEX_DB_HOST_DEVELOPMENT=
SISCAEX_DB_USER_DEVELOPMENT=
SISCAEX_DB_PASSWORD_DEVELOPMENT=
